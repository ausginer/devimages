{
  "name": "ai-service-image",
  "image": "node:slim",
  "workspaceFolder": "/workspace",
  "remoteUser": "node",
  "updateRemoteUserUID": true,
  "containerEnv": {
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",
  },
  "remoteEnv": {
    "CARGO_HOME": "${containerEnv:HOME}/.cargo",
    "PATH": "${containerEnv:HOME}/.cargo/bin:${containerEnv:PATH}",
    "UV_CACHE_DIR": "${containerEnv:HOME}/.cache/uv",
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "node",
      "userUid": "automatic",
      "userGid": "automatic",
      "installZsh": false,
      "installOhMyZsh": false,
      "installOhMyZshConfig": false,
    },
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {},
    "ghcr.io/rails/devcontainer/features/postgres-client:1": {},
    "ghcr.io/kreemer/features/chrometesting:1": {
      "version": "Stable",
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {},
    "./features/cargo-tools": {},
    "./features/uv-python": {},
    "./features/claude-cli": {},
    "./features/codex-cli": {},
    "./features/opencode-cli": {},
    "./features/dura": {},
    "./features/just": {},
  },
}
